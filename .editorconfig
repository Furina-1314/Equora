root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cc,cpp,cxx,h,hpp}]
indent_style = space
indent_size = 4

[*.{cs,xaml,csproj,sln}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,manifest}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{CMakeLists.txt,*.cmake,*.cmake.in}]
indent_style = space
indent_size = 4
