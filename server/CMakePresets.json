{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "win-x64-release",
      "displayName": "Windows x64 Release (MSVC + vcpkg)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "win-x64-server",
      "displayName": "Windows x64 Server (Drogon + libpq, heavy)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "EQUORA_BUILD_SERVER": "ON",
        "VCPKG_MANIFEST_DIR": "${sourceDir}/Equora.Server"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-x64-release",
      "configurePreset": "win-x64-release",
      "configuration": "Release"
    },
    {
      "name": "win-x64-server",
      "configurePreset": "win-x64-server",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "win-x64-release",
      "configurePreset": "win-x64-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
