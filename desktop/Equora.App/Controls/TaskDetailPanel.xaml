<UserControl
    x:Class="Equora.App.Controls.TaskDetailPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <!-- 未选中提示 -->
        <TextBlock Text="选择一个任务查看详情"
                   Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsLoaded, Converter={StaticResource BoolToInvisibleConverter}}" />

        <!-- 详情编辑 -->
        <ScrollViewer Padding="16,12"
                      Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibleConverter}}">
            <StackPanel Spacing="10">
                <TextBlock Text="任务详情" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{Binding CreatedInfo}" Opacity="0.6"
                           Style="{StaticResource CaptionTextBlockStyle}" />

                <TextBox Header="标题" Text="{Binding Title, Mode=TwoWay}" />
                <TextBox Header="备注" Text="{Binding Note, Mode=TwoWay}"
                         AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" />

                <ComboBox Header="状态" SelectedIndex="{Binding StatusIndex, Mode=TwoWay}">
                    <x:String>收集箱</x:String>
                    <x:String>已安排</x:String>
                    <x:String>进行中</x:String>
                    <x:String>等待中</x:String>
                    <x:String>已完成</x:String>
                    <x:String>已取消</x:String>
                </ComboBox>

                <ComboBox Header="优先级" SelectedIndex="{Binding PriorityIndex, Mode=TwoWay}">
                    <x:String>无</x:String>
                    <x:String>低</x:String>
                    <x:String>普通</x:String>
                    <x:String>高</x:String>
                    <x:String>紧急</x:String>
                </ComboBox>

                <CheckBox Content="设定截止时间" IsChecked="{Binding HasDue, Mode=TwoWay}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <DatePicker Date="{Binding DueDate, Mode=TwoWay}" Header="日期" />
                    <TimePicker Time="{Binding DueTime, Mode=TwoWay}" Header="时间" />
                    <Button Content="保存截止" Click="OnCommitDue" VerticalAlignment="Bottom" />
                </StackPanel>

                <TextBox Header="预计时长(分钟)" Text="{Binding EstimateText, Mode=TwoWay}"
                         LostFocus="OnEstimateLostFocus" />

                <TextBlock Text="标签" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                <ItemsControl x:Name="TagList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" Margin="0,2,0,2"
                                      IsChecked="{Binding IsAssigned, Mode=TwoWay}"
                                      Click="OnTagClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="检查项" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="NewChecklistText" PlaceholderText="添加检查项…" Width="220"
                             KeyDown="OnChecklistKeyDown" />
                    <Button Content="添加" Click="OnAddChecklist" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Checklist}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" MinWidth="0"
                                          IsChecked="{Binding IsChecked, Mode=OneWay}"
                                          Click="OnToggleChecklist" />
                                <TextBlock Grid.Column="1" Text="{Binding Content}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="×" FontSize="12" Padding="6,2"
                                        Click="OnRemoveChecklist" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
