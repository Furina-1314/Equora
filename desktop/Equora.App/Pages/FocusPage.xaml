<Page
    x:Class="Equora.App.Pages.FocusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Name="Root">

    <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
    <Grid Padding="32,28" ColumnSpacing="24" RowSpacing="24" SizeChanged="OnLayoutSizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="CaptureColumn" Width="340" />
        </Grid.ColumnDefinitions>

        <!-- 左:会话 -->
        <StackPanel Grid.Column="0" Spacing="20" HorizontalAlignment="Stretch">
            <TextBlock Text="专注" Style="{StaticResource EquoraPageTitleStyle}" />
            <TextBlock Text="{Binding SessionHint}" Opacity="0.7" />
            <TextBlock Text="{Binding RoundStatus}" Opacity="0.7" TextWrapping="Wrap" />

            <TextBlock x:Name="FocusClock" Text="{Binding ClockText}" FontSize="80" FontWeight="Light" Foreground="{ThemeResource EquoraAccentBrush}"
                       HorizontalAlignment="Center" />

            <!-- 温和提醒条 -->
            <Border Background="#18C09030" CornerRadius="0" Padding="10,6"
                    Visibility="{Binding NudgeText, Converter={StaticResource NonEmptyToVisibleConverter}}">
                <TextBlock Text="{Binding NudgeText}" TextWrapping="Wrap" FontSize="13" />
            </Border>

            <!-- 未开始:配置区 -->
            <StackPanel Spacing="10" Visibility="{Binding IsRunning, Converter={StaticResource FalseToVisibleXConverter}}">
                <ComboBox Header="模式" SelectedIndex="{Binding ModeIndex, Mode=TwoWay}"
                          ItemsSource="{Binding ModeNames}" HorizontalAlignment="Stretch" />
                <StackPanel Spacing="12">
                    <NumberBox Header="时长(分钟)" Value="{Binding PlannedMinutes, Mode=TwoWay}"
                               Minimum="1" Maximum="240" SpinButtonPlacementMode="Compact"
                               Width="160" HorizontalAlignment="Left" Visibility="{Binding IsTimed, Converter={StaticResource TrueToVisibleConverter2}}" />
                    <StackPanel Spacing="8" Visibility="{Binding IsPomodoro, Converter={StaticResource TrueToVisibleConverter2}}">
                        <NumberBox Header="番茄钟轮数" Value="{Binding Rounds, Mode=TwoWay}" Minimum="1" Maximum="20" SpinButtonPlacementMode="Compact" LostFocus="OnCycleSettingsChanged" />
                        <NumberBox Header="轮间休息（分钟）" Value="{Binding BreakMinutes, Mode=TwoWay}" Minimum="1" Maximum="60" SpinButtonPlacementMode="Compact" LostFocus="OnCycleSettingsChanged" />
                    </StackPanel>
                    <TextBlock Text="{Binding ModeDescription}" TextWrapping="Wrap" Opacity="0.65" />
                    <ComboBox Header="关联任务(可选)" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding CandidateTasks}"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedTaskId, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <TextBox Header="本次目标" Text="{Binding Goal, Mode=TwoWay}"
                         PlaceholderText="开始前写下完成标准" />
                <ComboBox Header="专注预设" ItemsSource="{Binding Profiles}" HorizontalAlignment="Stretch"
                          SelectionChanged="OnProfileSelected"
                          PlaceholderText="选择预设(可选)">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

            </StackPanel>

            <Button Command="{Binding ToggleSessionCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" AutomationProperties.Name="{Binding PrimaryActionText}">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{Binding PrimaryActionGlyph}" FontSize="16" /><TextBlock Text="{Binding PrimaryActionText}" /></StackPanel>
            </Button>
            <!-- 进行中:控制区 -->
            <StackPanel Orientation="Horizontal" Spacing="8"
                        Visibility="{Binding IsRunning, Converter={StaticResource TrueToVisibleConverter2}}">


                <Button Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding CompleteCommand}"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE73E;" FontSize="14" /><TextBlock Text="完成" /></StackPanel></Button>
                <Button Command="{Binding AbandonCommand}"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE71A;" FontSize="14" /><TextBlock Text="结束" /></StackPanel></Button>
            </StackPanel>

            <TextBlock Text="{Binding StatusText}" Opacity="0.75" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 右:分心捕获 + 待整理 -->
        <Grid x:Name="CapturePanel" Grid.Column="1" Padding="24,20" Background="{ThemeResource EquoraPaneBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="8">
                <TextBlock Text="随手记录" FontSize="20" />
                <TextBox x:Name="CaptureBox" PlaceholderText="想到什么…回车记录"
                         KeyDown="OnCaptureKeyDown" />
                <Button Content="记录" Click="OnCaptureClick" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="待整理" FontWeight="SemiBold" Margin="0,14,0,6" />

            <ListView Grid.Row="2" MaxHeight="440" ItemsSource="{Binding Pending}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Content}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="转任务" FontSize="12" Padding="8,2"
                                    Click="OnResolveAsTask" />
                            <Button Grid.Column="2" Content="丢弃" FontSize="12" Padding="8,2"
                                    Click="OnDiscard" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
    </ScrollViewer>
</Page>
