<Page
    x:Class="Equora.App.Pages.FocusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="340" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- 左:会话 -->
        <StackPanel Grid.Column="0" Spacing="14" MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Text="专注" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{Binding SessionHint}" Opacity="0.7" />

            <TextBlock Text="{Binding ClockText}" FontSize="64" FontFamily="Consolas"
                       HorizontalAlignment="Center" />

            <!-- 温和提醒条 -->
            <Border Background="#18C09030" CornerRadius="6" Padding="10,6"
                    Visibility="{Binding NudgeText, Converter={StaticResource NonEmptyToVisibleConverter}}">
                <TextBlock Text="{Binding NudgeText}" TextWrapping="Wrap" FontSize="13" />
            </Border>

            <!-- 未开始:配置区 -->
            <StackPanel Spacing="10" Visibility="{Binding IsRunning, Converter={StaticResource FalseToVisibleXConverter}}">
                <ComboBox Header="模式" SelectedIndex="{Binding ModeIndex, Mode=TwoWay}"
                          ItemsSource="{Binding ModeNames}" MinWidth="160" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <NumberBox Header="时长(分钟)" Value="{Binding PlannedMinutes, Mode=TwoWay}"
                               Minimum="1" Maximum="240" SpinButtonPlacementMode="Compact"
                               Width="160" />
                    <ComboBox Header="关联任务(可选)" MinWidth="200"
                              ItemsSource="{Binding CandidateTasks}"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedTaskId, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <TextBox Header="本次目标" Text="{Binding Goal, Mode=TwoWay}"
                         PlaceholderText="开始前写下完成标准" />
                <ComboBox Header="专注预设" ItemsSource="{Binding Profiles}" MinWidth="200"
                          SelectionChanged="OnProfileSelected"
                          PlaceholderText="选择预设(可选)">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="▶ 开始专注" Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding StartCommand}" HorizontalAlignment="Left" />
            </StackPanel>

            <!-- 进行中:控制区 -->
            <StackPanel Orientation="Horizontal" Spacing="8"
                        Visibility="{Binding IsRunning, Converter={StaticResource TrueToVisibleConverter2}}">
                <Button Content="⏸ 暂停" Command="{Binding PauseCommand}" />
                <Button Content="▶ 继续" Command="{Binding ResumeCommand}" />
                <Button Content="✔ 完成" Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding CompleteCommand}" />
                <Button Content="✖ 放弃" Command="{Binding AbandonCommand}" />
            </StackPanel>

            <TextBlock Text="{Binding StatusText}" Opacity="0.75" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 右:分心捕获 + 待整理 -->
        <Grid Grid.Column="1" Padding="16,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="8">
                <TextBlock Text="分心捕获(随时记录,不打断)" FontWeight="SemiBold" />
                <TextBox x:Name="CaptureBox" PlaceholderText="想到什么…回车记录"
                         KeyDown="OnCaptureKeyDown" />
                <Button Content="记录" Click="OnCaptureClick" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="待整理" FontWeight="SemiBold" Margin="0,14,0,6" />

            <ListView Grid.Row="2" ItemsSource="{Binding Pending}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Content}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="转任务" FontSize="12" Padding="8,2"
                                    Click="OnResolveAsTask" />
                            <Button Grid.Column="2" Content="丢弃" FontSize="12" Padding="8,2"
                                    Command="{Binding DataContext.DiscardCommand, ElementName=Root}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
