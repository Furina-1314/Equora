<Page
    x:Class="Equora.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="24,16" Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" />

        <TextBlock Text="主题" Style="{StaticResource SubtitleTextBlockStyle}" />
        <RadioButtons x:Name="ThemeChoice" Header="应用外观(默认跟随系统)"
                      SelectionChanged="OnThemeChanged">
            <x:String>跟随系统</x:String>
            <x:String>浅色</x:String>
            <x:String>深色</x:String>
        </RadioButtons>

        <TextBlock Text="关于" Style="{StaticResource SubtitleTextBlockStyle}" />
        <TextBlock x:Name="AboutText" Opacity="0.7" TextWrapping="Wrap" />
    </StackPanel>
</Page>
