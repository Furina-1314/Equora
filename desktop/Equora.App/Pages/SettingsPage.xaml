<Page x:Class="Equora.App.Pages.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"><StackPanel Padding="32,28" Spacing="20" HorizontalAlignment="Stretch">
  <TextBlock Text="设置" Style="{StaticResource EquoraPageTitleStyle}" Margin="0" />
  <TextBlock Text="个性化工作空间，管理启动与数据。" Opacity="0.65" />
  <InfoBar x:Name="SettingsNotice" IsOpen="False" IsClosable="True" />
  <Border Style="{StaticResource EquoraSectionStyle}"><StackPanel Spacing="16">
   <TextBlock Text="外观" FontSize="20" />
   <RadioButtons x:Name="ThemeChoice" Header="主题模式" SelectionChanged="OnThemeChanged"><x:String>跟随系统</x:String><x:String>浅色</x:String><x:String>深色</x:String></RadioButtons>
   <ComboBox x:Name="AccentChoice" Header="主题色" HorizontalAlignment="Stretch" SelectionChanged="OnAccentChanged">
    <ComboBoxItem Content="绯红" Tag="#C32F37" /><ComboBoxItem Content="Windows 蓝" Tag="#0078D4" />
    <ComboBoxItem Content="深青" Tag="#008272" /><ComboBoxItem Content="紫罗兰" Tag="#744DA9" />
    <ComboBoxItem Content="琥珀" Tag="#A65E00" /><ComboBoxItem Content="石墨" Tag="#52616B" /><ComboBoxItem Content="自定义" Tag="custom" />
   </ComboBox>
   <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <TextBox x:Name="AccentHex" Header="自定义颜色（#RRGGBB）" MaxLength="7" PlaceholderText="#C32F37" TextChanged="OnAccentHexChanged" />
    <Border x:Name="AccentPreview" Grid.Column="1" Width="36" VerticalAlignment="Stretch"
            Background="#D3D3D3" IsTapEnabled="True" Tapped="OnAccentPreviewTapped"
            ToolTipService.ToolTip="点击打开选色表" />
    <Button Grid.Column="2" Content="应用" VerticalAlignment="Bottom" Click="OnApplyAccent" />
   </Grid>
   <TextBlock Text="更改立即生效并自动保存。高对比度模式遵循 Windows 系统颜色。" TextWrapping="Wrap" Opacity="0.65" />
  </StackPanel></Border>
  <Border Style="{StaticResource EquoraSectionStyle}"><StackPanel Spacing="12">
   <TextBlock Text="桌面小组件" FontSize="20" />
   <TextBlock Text="在桌面上常驻的小窗口,随应用启动自动恢复;关闭小组件窗口即停用,可在此重新打开。" TextWrapping="Wrap" Opacity="0.65" />
   <ToggleSwitch x:Name="TaskWidgetToggle" Header="任务小组件" OffContent="已关闭" OnContent="显示未完成任务,打勾即完成" Toggled="OnTaskWidgetToggled" />
   <ToggleSwitch x:Name="CalendarWidgetToggle" Header="日历小组件" OffContent="已关闭" OnContent="日视图 / 周视图 / 议程" Toggled="OnCalendarWidgetToggled" />
  </StackPanel></Border>
  <Border Style="{StaticResource EquoraSectionStyle}"><StackPanel Spacing="16">
   <TextBlock Text="数据与备份" FontSize="20" /><TextBlock x:Name="AboutText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Opacity="0.75" />
   <StackPanel Spacing="8"><Button Content="立即备份（选择位置）" Style="{StaticResource AccentButtonStyle}" Click="OnBackupNow" /><Button Content="打开数据目录" Click="OnOpenDataFolder" /><Button Content="更改数据目录" Click="OnChangeDataDirectory" /></StackPanel>
   <TextBlock x:Name="BackupStatus" TextWrapping="Wrap" />
   <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="导出 JSON" Click="OnExportJson" /><Button Content="导出 CSV" Click="OnExportCsv" /><Button Content="导入 JSON" Click="OnImportJson" /></StackPanel>
   <TextBlock x:Name="TransferStatus" TextWrapping="Wrap" />
   <Button Content="清空数据…" Click="OnClearData" />
  </StackPanel></Border>
  <Border Style="{StaticResource EquoraSectionStyle}"><StackPanel Spacing="16">
   <TextBlock Text="学期模式" FontSize="20" />
   <ToggleSwitch x:Name="SemesterToggle" Header="开启学期模式" Toggled="OnSemesterToggled" />
   <StackPanel x:Name="SemesterFields" Spacing="12" Visibility="Collapsed">
    <TextBox x:Name="SemesterName" Header="学期名" />
    <CalendarDatePicker x:Name="SemesterStart" Header="起始日期" />
    <CalendarDatePicker x:Name="SemesterEnd" Header="结束日期" />
    <TextBlock Text="每周为周一至周日，起始日期所在周为第 1 周；仅在学期日期范围内批量添加日程。" TextWrapping="Wrap" Opacity="0.7" />
    <Button Content="保存学期设置" Click="OnSaveSemester" />
   <TextBlock x:Name="SemesterStatus" TextWrapping="Wrap" />
   <TextBlock Text="以往学期" FontWeight="SemiBold" />
   <ComboBox x:Name="ArchivedSemesterChoice" Header="已结束并归档的学期" HorizontalAlignment="Stretch" />
   <Button Content="查看所选学期日历" Click="OnViewArchivedSemester" />
   </StackPanel>
  </StackPanel></Border>
  <Border Style="{StaticResource EquoraSectionStyle}"><StackPanel Spacing="16">
   <TextBlock Text="启动与关闭" FontSize="20" />
   <ComboBox x:Name="CloseChoice" Header="点击窗口关闭按钮时" SelectionChanged="OnCloseChanged"><x:String>退出程序</x:String><x:String>隐藏窗口，在托盘继续运行</x:String></ComboBox>
   <ToggleSwitch x:Name="StartupToggle" Header="登录 Windows 时自动启动" Toggled="OnStartupChanged" />
   <TextBlock Text="托盘图标单击可恢复窗口，右键可退出程序。后台运行时专注计时和使用限制继续生效。" TextWrapping="Wrap" Opacity="0.7" />
   <Button Content="使用帮助与快捷键" Click="OnHelp" />
  </StackPanel></Border>
 </StackPanel></ScrollViewer>
</Page>
