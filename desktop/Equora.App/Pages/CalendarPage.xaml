<Page
    x:Class="Equora.App.Pages.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Equora.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource EquoraSurfaceBrush}" SizeChanged="OnLayoutSizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer x:Name="CalendarSidebar" Grid.Column="0" Grid.RowSpan="2" Padding="20,24" Background="{ThemeResource EquoraPaneBrush}">
            <StackPanel Spacing="12">
                <TextBlock Text="日历" Style="{StaticResource EquoraPageTitleStyle}" />
                <ComboBox Header="视图" SelectedIndex="{Binding ViewModeIndex, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" SelectionChanged="OnViewModeSelectionChanged">
                    <x:String>周视图</x:String>
                    <x:String>日视图</x:String>
                    <x:String>议程</x:String>
                </ComboBox>

                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Click="OnPrev" AutomationProperties.Name="上一时段"><FontIcon Glyph="&#xE76B;" FontSize="14" /></Button>
                    <Button Content="今天" Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding GoTodayCommand}" />
                    <Button Click="OnNext" AutomationProperties.Name="下一时段"><FontIcon Glyph="&#xE76C;" FontSize="14" /></Button>
                </StackPanel>

                <Button Content="新建时间段" Click="OnNewBlock" Style="{StaticResource AccentButtonStyle}" />
                <TextBlock x:Name="SemesterWeekLabel" Visibility="Collapsed" TextWrapping="Wrap" />
                <Button x:Name="SemesterBatchButton" Content="按学期批量添加" Visibility="Collapsed" Click="OnSemesterBatch" />
                <TextBlock Text="点击日历空白处快速新建；右键时间段或日程可编辑、删除。" TextWrapping="Wrap" Opacity="0.65" />
                <TextBlock Text="未安排任务 · 拖入日历" Opacity="0.6"
                           Style="{StaticResource CaptionTextBlockStyle}" Margin="0,8,0,0" />
                <ListView ItemsSource="{Binding UnscheduledTasks}" CanDragItems="True"
                          DragItemsStarting="OnTaskDragStarting" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Spacing="2" Padding="0,4">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,12,0,0">
                    <Button Content="导出 ICS" Click="OnExportIcs" />
                    <Button Content="导入 ICS" Click="OnImportIcs" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" Opacity="0.7" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="CalendarBody" Grid.Column="1" Grid.RowSpan="2" Margin="20,24,24,24">
            <ScrollViewer x:Name="WeekHost" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <controls:WeekView x:Name="Week" MinWidth="560" />
            </ScrollViewer>
            <ListView x:Name="AgendaList" Visibility="Collapsed" SelectionMode="None" RightTapped="OnAgendaRightTapped"
                      Padding="8,0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Vertical" Spacing="2" Padding="0,6">
                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" />
                            <TextBlock Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="{Binding Span.Start, Converter={StaticResource DueTextConverter}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
