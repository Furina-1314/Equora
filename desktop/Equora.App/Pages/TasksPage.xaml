<Page
    x:Class="Equora.App.Pages.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Equora.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="Root">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" MinWidth="280" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- 左栏:智能清单 / 项目 / 标签 -->
        <ScrollViewer Grid.Column="0" Padding="8,12">
            <StackPanel Spacing="4">
                <TextBlock Text="清单" Style="{StaticResource CaptionTextBlockStyle}"
                           Margin="8,0,0,4" Opacity="0.6" />
                <ListView ItemsSource="{Binding Lists}" SelectionMode="Single"
                          SelectedItem="{Binding SelectedList, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="{Binding Glyph}" FontSize="14" />
                                <TextBlock Text="{Binding Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="项目" Style="{StaticResource CaptionTextBlockStyle}"
                           Margin="8,16,0,4" Opacity="0.6" />
                <ListView x:Name="ProjectNav" SelectionMode="Single"
                          SelectionChanged="OnProjectSelected">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8F1;" FontSize="14" />
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="标签" Style="{StaticResource CaptionTextBlockStyle}"
                           Margin="8,16,0,4" Opacity="0.6" />
                <ListView x:Name="TagNav" SelectionMode="Single"
                          SelectionChanged="OnTagSelected">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8EC;" FontSize="14" />
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>

        <!-- 中栏:搜索 + 操作 + 任务列表 -->
        <Grid Grid.Column="1" Padding="12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Header="搜索标题与备注"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnSearchKeyDown" />
                <Button Grid.Column="1" Content="搜索" Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding RunSearchCommand}" VerticalAlignment="Bottom" />
                <Button Grid.Column="2" Content="新建" VerticalAlignment="Bottom"
                        Command="{Binding NewTaskCommand}" />
                <Button Grid.Column="3" Content="撤销" VerticalAlignment="Bottom"
                        Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" />
            </Grid>

            <TextBlock Grid.Row="1" Text="{Binding StatusText}" Opacity="0.7"
                       Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,0,8" />

            <ListView Grid.Row="2" ItemsSource="{Binding Tasks}" SelectionMode="Single"
                      SelectedItem="{Binding SelectedTask, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="8" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" MinWidth="0" Click="OnToggleDoneClick"
                                      IsChecked="{Binding Status, Converter={StaticResource DoneStatusConverter}, Mode=OneWay}" />
                            <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="2">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding DueAt, Converter={StaticResource DueTextConverter}}"
                                           Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                            </StackPanel>
                            <Border Grid.Column="2" Width="4" CornerRadius="2"
                                    VerticalAlignment="Stretch"
                                    Background="{Binding Priority, Converter={StaticResource PriorityBrushConverter}}" />
                            <Button Grid.Column="3" Content="删除" FontSize="12" Padding="8,2"
                                    Command="{Binding DataContext.DeleteTaskCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding IsDeleted, Converter={StaticResource FalseToVisibleConverter}}" />
                            <Button Grid.Column="4" Content="恢复" FontSize="12" Padding="8,2"
                                    Command="{Binding DataContext.RestoreTaskCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding IsDeleted, Converter={StaticResource TrueToVisibleConverter}}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- 右栏:详情 -->
        <controls:TaskDetailPanel Grid.Column="2" x:Name="DetailPanel" />
    </Grid>
</Page>
