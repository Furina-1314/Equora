<Page x:Class="Equora.App.Pages.HomePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"><StackPanel Padding="32,28" Spacing="24" HorizontalAlignment="Stretch">
  <StackPanel Spacing="8"><TextBlock Text="工作概览" Style="{StaticResource EquoraPageTitleStyle}" Margin="0" /><TextBlock x:Name="DateLabel" Opacity="0.65" /></StackPanel>
  <Border Style="{StaticResource EquoraSectionStyle}"><StackPanel Spacing="16">
   <TextBlock Text="安排时间，专注当下。" FontSize="28" FontWeight="Light" TextWrapping="Wrap" />
   <TextBlock x:Name="SummaryLabel" TextWrapping="Wrap" />
   <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="管理任务" Click="OnTasks" Style="{StaticResource AccentButtonStyle}" /><Button Content="查看日历" Click="OnCalendar" /><Button Content="开始专注" Click="OnFocus" /></StackPanel>
  </StackPanel></Border>
  <TextBlock Text="待处理任务" FontSize="20" />
  <TextBlock x:Name="EmptyLabel" Text="暂无待处理任务。可前往任务页添加。" Visibility="Collapsed" Opacity="0.65" />
  <ListView x:Name="OverviewTasks" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnTaskClicked" ItemContainerStyle="{StaticResource EquoraTaskItemStyle}">
   <ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <FontIcon Glyph="&#xE8A5;" FontSize="18" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="17" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    <TextBlock Grid.Column="2" Text="{Binding DueAt, Converter={StaticResource DueTextConverter}}" Opacity="0.65" VerticalAlignment="Center" />
   </Grid></DataTemplate></ListView.ItemTemplate>
  </ListView>
 </StackPanel></ScrollViewer>
</Page>
