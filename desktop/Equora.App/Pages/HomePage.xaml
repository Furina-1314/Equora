<Page
    x:Class="Equora.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="Root">

    <ScrollViewer Padding="24,16">
        <StackPanel Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="衡序 Equora" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="本地优先的日程规划与专注软件 —— M0 工程骨架" Opacity="0.7"
                       Style="{StaticResource CaptionTextBlockStyle}" />

            <TextBlock x:Name="StatusText" Text="{Binding StatusText}" FontWeight="SemiBold" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="运行自检" Command="{Binding RunDiagnosticsCommand}" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="新建冒烟任务" Command="{Binding AddSampleTaskCommand}" />
            </StackPanel>

            <TextBlock Text="诊断输出" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ItemsControl ItemsSource="{Binding Diagnostics}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Consolas" Margin="0,2,0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}">
                <Run Text="任务(" /><Run Text="{Binding TaskCount, Mode=OneWay}" /><Run Text=")" />
            </TextBlock>
            <ListView ItemsSource="{Binding Tasks}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7C1;" FontSize="14" Opacity="0.6" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="完成"
                                    Command="{Binding DataContext.CompleteTaskCommand, ElementName=Root}"
                                    CommandParameter="{Binding}" />
                            <Button Grid.Column="2" Content="删除"
                                    Command="{Binding DataContext.DeleteTaskCommand, ElementName=Root}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
