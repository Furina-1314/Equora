    <Style x:Key="EquoraTaskItemStyle" TargetType="ListViewItem">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{ThemeResource EquoraSurfaceBrush}" />
