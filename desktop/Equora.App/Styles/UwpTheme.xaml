    <Style x:Key="EquoraPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{ThemeResource EquoraAccentBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
