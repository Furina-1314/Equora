<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.0.2</Version>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>1.0.2.0</FileVersion>
    <ApplicationIcon>Assets\Equora.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Equora.App</RootNamespace>
    <!-- 非打包运行用 Win32 清单;MSIX 打包(-p:WindowsPackageType=MSIX)改用 Package.appxmanifest -->
    <ApplicationManifest Condition="'$(WindowsPackageType)' != 'MSIX'">app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 开发期以非打包方式运行;MSIX 打包在发布阶段(P16)启用。 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSdkSelfContained>true</WindowsAppSdkSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Equora.NativeHost\Equora.NativeHost.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Equora.App.Services\Equora.App.Services.csproj" />
    <ProjectReference Include="..\Equora.App.ViewModels\Equora.App.ViewModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\extension\Equora.BrowserExtension\*.js;..\..\extension\Equora.BrowserExtension\*.html;..\..\extension\Equora.BrowserExtension\*.json;..\..\extension\Equora.BrowserExtension\*.png" Link="BrowserExtension\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyBrowserHost" AfterTargets="Build">
    <ItemGroup><BrowserHostFiles Include="..\Equora.NativeHost\bin\$(Platform)\$(Configuration)\$(TargetFramework)\com.equora.nativehost.*" /></ItemGroup>
    <Copy SourceFiles="@(BrowserHostFiles)" DestinationFolder="$(OutDir)BrowserHost" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutDir)Equora.App.Services.dll;$(OutDir)Equora.App.NativeInterop.dll" DestinationFolder="$(OutDir)BrowserHost" SkipUnchangedFiles="true" />
  </Target>

  <!-- MSIX 侧载打包:dotnet build -p:WindowsPackageType=MSIX -p:PackageCertificateKeyFile=<pfx> [-p:PackageCertificatePassword=<pwd>] -->
  <PropertyGroup Condition="'$(WindowsPackageType)' == 'MSIX'">
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled Condition="'$(AppxPackageSigningEnabled)' == ''">true</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
  </PropertyGroup>

  <!-- 原生 C ABI DLL(含 vcpkg 的 sqlite3.dll)以 Content 进入输出与 MSIX 布局;目录不存在时跳过(CI 先构建原生)。 -->
  <ItemGroup Condition="Exists('..\..\native\build\win-x64-release\Schedule.CApi\Release\equora_capi.dll')">
    <Content Include="..\..\native\build\win-x64-release\Schedule.CApi\Release\*.dll"
             CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
