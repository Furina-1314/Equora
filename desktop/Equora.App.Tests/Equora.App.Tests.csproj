<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Equora.App.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
    <ProjectReference Include="..\Equora.App.ViewModels\Equora.App.ViewModels.csproj" />
  </ItemGroup>

  <!-- 从本地 C++ 构建输出复制 equora_capi.dll/sqlite3.dll;目录不存在时跳过(如 CI) -->
  <Target Name="CopyNativeBinaries" AfterTargets="Build"
          Condition="Exists('..\..\native\build\win-x64-release\Schedule.CApi\Release\equora_capi.dll')">
    <ItemGroup>
      <NativeBin Include="..\..\native\build\win-x64-release\Schedule.CApi\Release\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeBin)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
